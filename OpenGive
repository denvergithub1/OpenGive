          <div class="form-row">
            <div>
              <label class="form-label">Emoji Icon</label>
              <input class="form-input" id="nc-icon" placeholder="🌊" value="🌍" />
            </div>
            <div>
              <label class="form-label">Accent Color</label>
              <input class="form-input" id="nc-color" placeholder="#38bfa1" value="#6366f1" />
            </div>
          </div>
          <label class="form-label">Description *</label>
          <textarea class="form-textarea" id="nc-desc" placeholder="Describe this cause and its impact..."></textarea>
          <button class="btn btn-teal" onclick="addCause()">+ Add Cause</button>
        </div>
      </div>

      <!-- Post Update -->
      <div class="admin-section" id="tab-post">
        <h3 style="font-family:var(--font-d);font-size:26px;color:var(--text);margin-bottom:8px">Post Impact Update</h3>
        <p style="color:var(--dim);margin-bottom:28px">Show contributors exactly how their money was used — this is public.</p>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:30px;margin-bottom:40px">
          <label class="form-label">Cause</label>
          <select class="form-select" id="upd-cause"></select>
          <label class="form-label">Update Title *</label>
          <input class="form-input" id="upd-title" placeholder="e.g. 5 Wells Drilled in Kenya" />
          <div class="form-row">
            <div>
              <label class="form-label">Amount Spent ($) *</label>
              <input class="form-input" type="number" id="upd-amount" placeholder="8500" />
            </div>
            <div>
              <label class="form-label">Receipt / Ref #</label>
              <input class="form-input" id="upd-receipt" placeholder="REC-2024-XXX" />
            </div>
          </div>
          <label class="form-label">Description *</label>
          <textarea class="form-textarea" id="upd-body" rows="4" placeholder="Describe what was accomplished..."></textarea>
          <button class="btn btn-gold" onclick="postUpdate()">📢 Publish Update</button>
        </div>
        <h3 style="font-family:var(--font-d);font-size:22px;color:var(--text);margin-bottom:18px">Previous Updates</h3>
        <div id="admin-updates-list"></div>
      </div>

      <!-- Contributors -->
      <div class="admin-section" id="tab-contributors">
        <h3 style="font-family:var(--font-d);font-size:26px;color:var(--text);margin-bottom:20px">All Contributors</h3>
        <div class="ledger-wrap">
          <div class="ledger-head">
            <span>Contributor</span><span>Cause</span><span style="text-align:right;padding-right:10px">Amount</span><span>Date</span>
          </div>
          <div id="admin-contrib-list"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ──────────────────────────────── DONATE MODAL ─────────────────────────── -->
<div class="modal-backdrop" id="donate-modal" onclick="closeModal()">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-header">
      <span class="modal-title" id="modal-title">Donate</span>
      <button class="modal-close" onclick="closeModal()">×</button>
    </div>
    <div id="modal-body"></div>
  </div>
</div>

<!-- ──────────────────────────────── FOOTER ───────────────────────────────── -->
<footer>
  <div class="footer-brand">OpenGive Foundation</div>
  <div class="footer-tagline">100% transparent · Every dollar tracked · Every impact reported</div>
  <div class="footer-links">
    <span class="footer-link">Privacy Policy</span>
    <span class="footer-link">Terms of Use</span>
    <span class="footer-link">Contact Us</span>
    <span class="footer-link">Annual Report</span>
  </div>
</footer>

<script>
// ─── Data ─────────────────────────────────────────────────────────────────────
const DB = {
  causes: [
    { id:'c1', name:'Clean Water Initiative', desc:'Providing safe drinking water to underserved communities in sub-Saharan Africa.', goal:50000, color:'#38bfa1', icon:'💧', active:true },
    { id:'c2', name:'Education for All',       desc:'Building schools and supplying materials for children in rural areas.',          goal:35000, color:'#d4a853', icon:'📚', active:true },
    { id:'c3', name:'Food Security Program',   desc:'Eliminating hunger through sustainable farming and community food banks.',        goal:40000, color:'#4a9eff', icon:'🌾', active:true },
    { id:'c4', name:'Disaster Relief Fund',    desc:'Rapid response support for communities affected by natural disasters.',          goal:60000, color:'#e05c5c', icon:'🆘', active:true },
  ],
  contributions: [
    { id:'d1', name:'Sarah M.',  email:'sarah@ex.com',  causeId:'c1', amount:500,  message:'Keep up the incredible work!',  ts: Date.now()-864e5*5, anon:false },
    { id:'d2', name:'Anonymous', email:'',              causeId:'c2', amount:250,  message:'',                              ts: Date.now()-864e5*4, anon:true  },
    { id:'d3', name:'James T.',  email:'james@ex.com',  causeId:'c3', amount:1000, message:'For the children.',             ts: Date.now()-864e5*3, anon:false },
    { id:'d4', name:'Priya K.',  email:'priya@ex.com',  causeId:'c1', amount:300,  message:'Water is life.',                ts: Date.now()-864e5*2, anon:false },
    { id:'d5', name:'Anonymous', email:'',              causeId:'c4', amount:750,  message:'Prayers for the affected.',     ts: Date.now()-864e5*1, anon:true  },
    { id:'d6', name:'Maria L.',  email:'maria@ex.com',  causeId:'c2', amount:200,  message:'Education changes everything.', ts: Date.now()-36e5*2,  anon:false },
  ],
  updates: [
    { id:'u1', causeId:'c1', title:'Wells Drilled in Kenya',    body:'Thanks to your generosity, 3 new wells were drilled serving 1,200 people in Kisumu county.',       ts:Date.now()-864e5*3, amount:8500,  receipt:'REC-2024-001' },
    { id:'u2', causeId:'c2', title:'50 Classrooms Renovated',   body:'We renovated 50 classrooms across 12 schools. 2,400 students now learn in safe environments.',       ts:Date.now()-864e5*1, amount:12000, receipt:'REC-2024-002' },
    { id:'u3', causeId:'c3', title:'Food Bank Opens in Detroit', body:'A new community food bank opened serving 400 families per week. Equipment purchased and installed.', ts:Date.now()-36e5*5,  amount:6200,  receipt:'REC-2024-003' },
  ]
};

// ─── Helpers ──────────────────────────────────────────────────────────────────
const $ = id => document.getElementById(id);
const fmt = n => new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n);
const fmtDate = ts => new Date(ts).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
const raised = cid => DB.contributions.filter(c=>c.causeId===cid).reduce((a,c)=>a+c.amount,0);
const spent  = cid => DB.updates.filter(u=>u.causeId===cid).reduce((a,u)=>a+u.amount,0);

const hashPw = async pw => {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
};
const ADMIN_HASH = '8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918'; // "admin"

// ─── Navigation ───────────────────────────────────────────────────────────────
let currentPage = 'home';

function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
  $('page-'+name).classList.add('active');
  $('nav-'+name).classList.add('active');
  currentPage = name;
  if (name === 'transparency') renderTransparency();
  if (name === 'admin' && adminAuthed) renderAdmin();
}

// ─── Home ─────────────────────────────────────────────────────────────────────
function renderHome() {
  const total = DB.contributions.reduce((a,c)=>a+c.amount,0);
  $('home-stats').innerHTML = `
    <div class="stat-card"><div class="stat-val">${fmt(total)}</div><div class="stat-label">Total Raised</div></div>
    <div class="stat-card"><div class="stat-val">${DB.contributions.length}</div><div class="stat-label">Contributors</div></div>
    <div class="stat-card"><div class="stat-val">${DB.causes.filter(c=>c.active).length}</div><div class="stat-label">Active Causes</div></div>
    <div class="stat-card"><div class="stat-val">${DB.updates.length}</div><div class="stat-label">Impact Reports</div></div>
  `;
  $('home-causes').innerHTML = DB.causes.filter(c=>c.active).map(c => {
    const r = raised(c.id), pct = Math.min(100, r/c.goal*100).toFixed(1);
    return `
      <div class="cause-card" style="--accent:${c.color}" onmouseenter="this.style.borderColor='${c.color}'" onmouseleave="this.style.borderColor=''">
        <div class="cause-icon">${c.icon}</div>
        <div>
          <div class="cause-name">${c.name}</div>
          <div class="cause-desc">${c.desc}</div>
        </div>
        <div class="progress-wrap"><div class="progress-bar" style="width:${pct}%;background:${c.color}"></div></div>
        <div class="cause-meta">
          <span class="cause-raised" style="color:${c.color}">${fmt(r)} raised</span>
          <span class="cause-goal">Goal: ${fmt(c.goal)}</span>
        </div>
        <button class="btn btn-teal" style="width:100%;background:linear-gradient(135deg,${c.color},${c.color}cc)" onclick="openDonate('${c.id}')">Donate ${c.icon}</button>
      </div>`;
  }).join('');
}

// ─── Transparency ─────────────────────────────────────────────────────────────
let ledgerFilter = 'all';

function renderTransparency() {
  // Per-cause stats
  $('transparency-stats').innerHTML = DB.causes.map(c => {
    const r = raised(c.id);
    return `<div class="stat-card"><div class="stat-val">${fmt(r)}</div><div class="stat-label">${c.name}</div><div class="stat-sub">${Math.round(r/c.goal*100)}% of goal</div></div>`;
  }).join('');

  // Filters
  $('ledger-filters').innerHTML =
    `<button class="filter-btn ${ledgerFilter==='all'?'active':''}" onclick="setFilter('all')">All (${DB.contributions.length})</button>` +
    DB.causes.map(c => {
      const n = DB.contributions.filter(x=>x.causeId===c.id).length;
      return `<button class="filter-btn ${ledgerFilter===c.id?'active':''}" onclick="setFilter('${c.id}')">${c.icon} ${c.name} (${n})</button>`;
    }).join('');

  renderLedger();
  renderUpdates();
}

function setFilter(f) {
  ledgerFilter = f;
  renderTransparency();
}

function renderLedger() {
  const list = ledgerFilter === 'all' ? DB.contributions : DB.contributions.filter(c=>c.causeId===ledgerFilter);
  const sorted = [...list].sort((a,b)=>b.ts-a.ts);
  $('ledger-body').innerHTML = sorted.map((c,i) => {
    const cause = DB.causes.find(x=>x.id===c.causeId);
    return `<div class="ledger-row">
      <div>
        <div class="contrib-name" style="color:${c.anon?'var(--dim)':'var(--text)'}">${c.anon?'🔒 Anonymous':c.name}</div>
        ${c.message?`<div class="contrib-msg">"${c.message}"</div>`:''}
      </div>
      <div class="contrib-cause">${cause?.icon}<span>${cause?.name}</span></div>
      <div class="contrib-amount">${fmt(c.amount)}</div>
      <div class="contrib-date">${fmtDate(c.ts)}</div>
    </div>`;
  }).join('');
  const total = list.reduce((a,c)=>a+c.amount,0);
  $('ledger-total').innerHTML = `Total: ${fmt(total)}`;
}

function renderUpdates() {
  $('updates-list').innerHTML = [...DB.updates].sort((a,b)=>b.ts-a.ts).map(u => {
    const cause = DB.causes.find(c=>c.id===u.causeId);
    return `<div class="update-card" style="border-left-color:${cause?.color||'var(--gold)'}">
      <div class="update-header">
        <div>
          <div class="update-title">${u.title}</div>
          <div class="update-meta">${cause?.icon} ${cause?.name} &middot; ${fmtDate(u.ts)}</div>
        </div>
        <div style="text-align:right">
          <div class="update-spent">${fmt(u.amount)}</div>
          <div class="update-receipt">Receipt: ${u.receipt}</div>
        </div>
      </div>
      <p class="update-body">${u.body}</p>
    </div>`;
  }).join('');
}

// ─── Admin Auth ───────────────────────────────────────────────────────────────
let adminAuthed = false;

async function adminLogin() {
  const pw = $('admin-pw').value;
  const h = await hashPw(pw);
  if (h === ADMIN_HASH) {
    adminAuthed = true;
    $('admin-login').style.display = 'none';
    $('admin-dashboard').style.display = 'block';
    renderAdmin();
  } else {
    $('admin-err').style.display = 'block';
  }
}

function adminLogout() {
  adminAuthed = false;
  $('admin-login').style.display = 'block';
  $('admin-dashboard').style.display = 'none';
  $('admin-pw').value = '';
  $('admin-err').style.display = 'none';
}

// ─── Admin Tabs ───────────────────────────────────────────────────────────────
function switchTab(name) {
  document.querySelectorAll('.admin-section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.admin-tab').forEach(t=>t.classList.remove('active'));
  $('tab-'+name).classList.add('active');
  event.currentTarget.classList.add('active');
  if (name==='post') populateCauseSelect();
}

// ─── Admin Render ─────────────────────────────────────────────────────────────
function renderAdmin() {
  const totalR = DB.contributions.reduce((a,c)=>a+c.amount,0);
  const totalS = DB.updates.reduce((a,u)=>a+u.amount,0);
  $('admin-stats').innerHTML = `
    <div class="stat-card"><div class="stat-val">${fmt(totalR)}</div><div class="stat-label">Total Raised</div></div>
    <div class="stat-card"><div class="stat-val">${fmt(totalS)}</div><div class="stat-label">Total Spent</div><div class="stat-sub">With receipts</div></div>
    <div class="stat-card"><div class="stat-val">${fmt(totalR-totalS)}</div><div class="stat-label">Available</div></div>
    <div class="stat-card"><div class="stat-val">${DB.contributions.length}</div><div class="stat-label">Contributions</div></div>
  `;

  $('admin-perf').innerHTML = DB.causes.map(c => {
    const r = raised(c.id), s = spent(c.id), pct = Math.min(100,r/c.goal*100).toFixed(1);
    return `<div class="perf-bar-wrap">
      <div class="perf-bar-header">
        <span style="font-weight:700;color:var(--text)">${c.icon} ${c.name}</span>
        <span style="font-size:13px">
          <span style="color:var(--teal)">${fmt(r)} raised</span>
          <span style="color:var(--dim)"> · </span>
          <span style="color:var(--red)">${fmt(s)} spent</span>
          <span style="color:var(--dim)"> · </span>
          <span style="color:var(--gold)">${fmt(r-s)} available</span>
        </span>
      </div>
      <div class="progress-wrap"><div class="progress-bar" style="width:${pct}%;background:${c.color}"></div></div>
    </div>`;
  }).join('');

  $('admin-causes-list').innerHTML = DB.causes.map(c => `
    <div class="admin-cause-row">
      <span class="admin-cause-name">${c.icon} ${c.name}</span>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="tag ${c.active?'tag-green':'tag-gold'}">${c.active?'Active':'Paused'}</span>
        <button class="btn ${c.active?'btn-red':'btn-teal'}" style="padding:7px 16px;font-size:13px" onclick="toggleCause('${c.id}')">${c.active?'Pause':'Activate'}</button>
      </div>
    </div>`).join('');

  $('admin-updates-list').innerHTML = [...DB.updates].sort((a,b)=>b.ts-a.ts).map(u => {
    const cause = DB.causes.find(c=>c.id===u.causeId);
    return `<div style="display:flex;justify-content:space-between;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px 22px;margin-bottom:12px;flex-wrap:wrap;gap:12px">
      <div><div style="font-weight:700;color:var(--text)">${u.title}</div><div style="font-size:13px;color:var(--dim);margin-top:3px">${cause?.icon} ${cause?.name} &middot; ${fmtDate(u.ts)}</div></div>
      <div style="color:var(--red);font-weight:800">${fmt(u.amount)}</div>
    </div>`;
  }).join('');

  $('admin-contrib-list').innerHTML = [...DB.contributions].sort((a,b)=>b.ts-a.ts).map((c,i) => {
    const cause = DB.causes.find(x=>x.id===c.causeId);
    return `<div class="ledger-row">
      <div>
        <div class="contrib-name">${c.name}</div>
        ${c.email?`<div class="contrib-msg">${c.email}</div>`:''}
      </div>
      <div class="contrib-cause">${cause?.icon}<span>${cause?.name}</span></div>
      <div class="contrib-amount">${fmt(c.amount)}</div>
      <div class="contrib-date">${fmtDate(c.ts)}</div>
    </div>`;
  }).join('');

  populateCauseSelect();
}

function populateCauseSelect() {
  const sel = $('upd-cause');
  if (sel) sel.innerHTML = DB.causes.map(c=>`<option value="${c.id}">${c.icon} ${c.name}</option>`).join('');
}

function toggleCause(id) {
  const c = DB.causes.find(x=>x.id===id);
  if (c) { c.active = !c.active; renderAdmin(); renderHome(); }
}

function addCause() {
  const name = $('nc-name').value.trim();
  const goal = parseFloat($('nc-goal').value);
  const desc = $('nc-desc').value.trim();
  if (!name||!goal||!desc) return alert('Please fill all required fields.');
  DB.causes.push({ id:'c'+Date.now(), name, desc, goal, color: $('nc-color').value||'#6366f1', icon: $('nc-icon').value||'🌍', active:true });
  ['nc-name','nc-goal','nc-desc'].forEach(id => $(id).value='');
  renderAdmin(); renderHome();
  alert('Cause added successfully!');
}

function postUpdate() {
  const title  = $('upd-title').value.trim();
  const body   = $('upd-body').value.trim();
  const amount = parseFloat($('upd-amount').value);
  const causeId= $('upd-cause').value;
  if (!title||!body||!amount) return alert('Please fill all required fields.');
  DB.updates.unshift({ id:'u'+Date.now(), causeId, title, body, amount, receipt: $('upd-receipt').value||'REC-'+Date.now(), ts: Date.now() });
  ['upd-title','upd-body','upd-amount','upd-receipt'].forEach(id => $(id).value='');
  renderAdmin();
  alert('Update published successfully! It is now visible in the Transparency Ledger.');
}

// ─── Donate Modal ─────────────────────────────────────────────────────────────
let donateState = { causeId:null, step:1, amount:0, custom:'', anon:false, name:'', email:'', msg:'', agree:false };

function openDonate(causeId) {
  donateState = { causeId, step:1, amount:0, custom:'', anon:false, name:'', email:'', msg:'', agree:false };
  renderDonateStep();
  $('donate-modal').classList.add('open');
}

function closeModal() {
  $('donate-modal').classList.remove('open');
}

function renderDonateStep() {
  const cause = DB.causes.find(c=>c.id===donateState.causeId);
  const s = donateState;

  if (s.step === 3) {
    $('modal-title').textContent = '🎉 Thank You!';
    $('modal-body').innerHTML = `<div class="success-panel">
      <div class="success-emoji">🌟</div>
      <h3 style="font-family:var(--font-d);font-size:28px;color:var(--text);margin-bottom:12px">Donation Confirmed!</h3>
      <p style="color:var(--muted);margin-bottom:10px">Your <strong style="color:var(--teal)">${fmt(getFinalAmount())}</strong> gift to <strong style="color:var(--text)">${cause?.name}</strong> has been recorded.</p>
      <p style="color:var(--dim);font-size:14px;margin-bottom:36px">You can view it in the Transparency Ledger. You'll receive an email receipt (in production).</p>
      <button class="btn btn-gold" style="width:100%;padding:13px" onclick="closeModal();showPage('transparency')">View Ledger &rarr;</button>
    </div>`;
    return;
  }

  $('modal-title').textContent = s.step===1 ? `Donate to ${cause?.name}` : `Confirm Your Gift`;
  const PRESETS = [25,50,100,250,500];

  if (s.step === 1) {
    $('modal-body').innerHTML = `
      <div class="cause-banner">
        <div class="cause-banner-icon">${cause?.icon}</div>
        <div>
          <div class="cause-banner-name">${cause?.name}</div>
          <div class="cause-banner-desc">${cause?.desc}</div>
        </div>
      </div>
      <label class="form-label">Choose Amount</label>
      <div class="preset-grid">
        ${PRESETS.map(p=>`<button class="preset-btn ${s.amount===p&&s.amount!=='custom'?'selected':''}" onclick="selectPreset(${p})">\$${p}</button>`).join('')}
        <button class="preset-btn ${s.amount==='custom'?'selected':''}" onclick="selectPreset('custom')">Custom</button>
      </div>
      <div id="custom-input-wrap" style="display:${s.amount==='custom'?'block':'none'}">
        <label class="form-label">Enter Amount ($)</label>
        <input class="form-input" type="number" id="custom-amt" value="${s.custom}" placeholder="Enter amount" oninput="donateState.custom=this.value" />
      </div>
      <button class="btn btn-teal" style="width:100%;padding:13px;margin-top:8px" onclick="goStep2()">Continue &rarr; ${getFinalAmount()>0?fmt(getFinalAmount()):''}</button>
    `;
  } else if (s.step === 2) {
    $('modal-body').innerHTML = `
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px">
        <button class="btn btn-ghost" style="padding:7px 12px" onclick="donateState.step=1;renderDonateStep()">&larr;</button>
        <span style="color:var(--teal);font-weight:800;font-size:20px">${fmt(getFinalAmount())}</span>
        <span style="color:var(--dim)">to ${cause?.icon} ${cause?.name}</span>
      </div>
      <label class="form-check">
        <input type="checkbox" id="chk-anon" ${s.anon?'checked':''} onchange="donateState.anon=this.checked;toggleAnonFields()" />
        <span>Donate anonymously — your name won't appear in the public ledger</span>
      </label>
      <div id="name-fields" style="display:${s.anon?'none':'block'}">
        <label class="form-label">Full Name *</label>
        <input class="form-input" id="inp-name" value="${s.name}" placeholder="Jane Doe" oninput="donateState.name=this.value" />
        <label class="form-label">Email (optional)</label>
        <input class="form-input" type="email" id="inp-email" value="${s.email}" placeholder="jane@example.com" oninput="donateState.email=this.value" />
      </div>
      <label class="form-label">Message (optional)</label>
      <textarea class="form-textarea" id="inp-msg" placeholder="Leave an encouraging message..." oninput="donateState.msg=this.value">${s.msg}</textarea>
      <div class="security-note">
        🔒 <strong style="color:var(--text)">Security:</strong> This is a demo — no real payment is processed.
        In production, we integrate Stripe (PCI-compliant, SSL-encrypted) or PayPal Giving Fund.
        Zero financial data is stored on this server.
      </div>
      <label class="form-check">
        <input type="checkbox" id="chk-agree" ${s.agree?'checked':''} onchange="donateState.agree=this.checked" />
        <span>I agree that this contribution will be publicly visible in the transparency ledger and confirm I am of legal age.</span>
      </label>
      <button class="btn btn-teal" style="width:100%;padding:14px;font-size:16px;margin-top:8px" onclick="confirmDonate()">✓ Confirm ${fmt(getFinalAmount())}</button>
    `;
  }
}

function getFinalAmount() {
  const s = donateState;
  if (s.amount === 'custom') return parseFloat(s.custom)||0;
  return typeof s.amount === 'number' ? s.amount : 0;
}

function selectPreset(val) {
  donateState.amount = val;
  if (val !== 'custom') donateState.custom = '';
  renderDonateStep();
  if (val === 'custom') setTimeout(()=>{ const el=$('custom-amt'); if(el) el.focus(); },50);
}

function toggleAnonFields() {
  const el = $('name-fields');
  if (el) el.style.display = donateState.anon ? 'none' : 'block';
}

function goStep2() {
  const amt = getFinalAmount();
  if (!amt||amt<=0) return alert('Please select or enter a valid amount.');
  donateState.step = 2;
  renderDonateStep();
}

function confirmDonate() {
  const s = donateState;
  const amt = getFinalAmount();
  if (!amt||amt<=0) return alert('Invalid amount.');
  if (!s.anon && !$('inp-name').value.trim()) return alert('Please enter your name or choose anonymous.');
  if (!$('chk-agree').checked) return alert('Please agree to the terms.');

  const contrib = {
    id: 'd'+Date.now(),
    name: s.anon ? 'Anonymous' : ($('inp-name').value.trim()||'Anonymous'),
    email: s.anon ? '' : ($('inp-email')?.value.trim()||''),
    causeId: s.causeId,
    amount: amt,
    message: $('inp-msg')?.value.trim()||'',
    ts: Date.now(),
    anon: s.anon
  };
  DB.contributions.push(contrib);
  renderHome();
  donateState.step = 3;
  renderDonateStep();
}

// ─── Init ─────────────────────────────────────────────────────────────────────
renderHome();

// Trigger progress bar animations
window.addEventListener('load', ()=>{
  setTimeout(()=>{
    document.querySelectorAll('.progress-bar').forEach(b=>{
      const w = b.style.width; b.style.width='0'; setTimeout(()=>b.style.width=w,50);
    });
  },200);
});
</script>
</body>
</html>
